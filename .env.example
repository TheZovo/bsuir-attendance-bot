# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Port for Mini App web server
PORT=3000

# Public URL for Telegram Mini App ('auto' for Docker tunnel auto-detection, or your custom domain)
WEBAPP_URL=auto

# Default BSUIR student group number (e.g. 310101, 150501, etc.)
DEFAULT_GROUP=310101

# Path to SQLite database file
DB_PATH=./data/attendance.sqlite
